# Where projects and build outputs live (shared between server and compiler)
DATA_DIR=./data
# Valkey/Redis used for the compile queue
REDIS_URL=redis://localhost:6379
# HTTP port of the API server
PORT=3000
# Max seconds a single compile may run
COMPILE_TIMEOUT=240
# PostgreSQL connection
DATABASE_URL=postgres://coltex:coltex@localhost:5432/coltex
# Public origin of ColTex (cookies, invite links). Unset, the dev server uses
# http://localhost:3000 and `docker compose` http://localhost:3690 (or
# COLTEX_PORT). Compose reads this file too, so set it only for the instance
# people actually use.
# COLTEX_URL=
# Extra origins allowed to use the API with cookies (the Vite dev server)
TRUSTED_ORIGINS=http://localhost:5173
# Behind a reverse proxy (e.g. the Caddy profile): trust its X-Forwarded-For.
# true, or addresses/ranges such as "uniquelocal". Leave unset otherwise.
# TRUST_PROXY=
# Session signing secret; generated into DATA_DIR/.secret when unset
# COLTEX_SECRET=

# Project files in an S3-compatible bucket instead of DATA_DIR/projects
# (AWS, Cloudflare R2, MinIO, Garage, SeaweedFS…). Move an existing instance
# with `node src/cli.ts copy-storage`. See docs/operations.md.
# STORAGE=s3
# S3_BUCKET=coltex
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# Leave unset for AWS; set for anything else, e.g. http://minio:9000
# S3_ENDPOINT=
# Optional folder inside the bucket
# S3_PREFIX=
# Bucket in the path rather than the host name; defaults to true when S3_ENDPOINT is set
# S3_PATH_STYLE=
# pg_dump and psql for backups/restore, when they aren't on PATH (the Docker image has them)
# PG_DUMP=/opt/homebrew/opt/libpq/bin/pg_dump
# PSQL=/opt/homebrew/opt/libpq/bin/psql

# Base image of the compiler. The default carries TeX Live documentation and
# sources for the AI assistant; texlive/texlive:latest is ~4.5 GB smaller.
# TEXLIVE_IMAGE=texlive/texlive:latest-full-doc-src
