    "@earendil-works/pi-ai": "1.2.0",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.5.1",
    "@hocuspocus/server": "^4.7.1",
    "@node-rs/argon2": "^2.2.2",
    "altcha-lib": "2.6.0",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.0",
    "bullmq": "^5.81.5",
    "crossws": "^0.4.15",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fast-diff": "^1.3.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "uqr": "0.1.3",
