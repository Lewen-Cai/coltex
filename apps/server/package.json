  "scripts": {
    "dev": "node scripts/ip2region.ts && node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p .",
    "cli": "node --env-file-if-exists=../../.env src/cli.ts",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 --test-timeout=30000 test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "ip2region": "node scripts/ip2region.ts"
  },
  "dependencies": {
    "@coltex/convert": "workspace:*",
