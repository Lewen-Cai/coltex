#!/usr/bin/env bash
# ColTex on this machine. Run from anywhere (install.sh links it into ~/.local/bin):
#
#   coltex start | stop | restart | status | logs [service] | version
#   coltex update [VERSION]          to the latest release (or VERSION, e.g. v0.0.2, or main)
#   coltex edition [standard | full]  show or switch the TeX Live edition (rebuilds the compiler)
#   coltex tailscale [status | up | down | off]
#   coltex cloudflare [status | quick | token [TOKEN] | off]
#   coltex cli <command…>          any `node src/cli.ts` command, e.g. `coltex cli system-admin <email>`
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
DIR="$(cd "$(dirname "$self")" && pwd)"
cd "$DIR"

compose() { docker compose "$@"; }
# The installed release (its tag), or main and the commit.
current() {
  if git symbolic-ref -q HEAD >/dev/null; then echo "$(git rev-parse --abbrev-ref HEAD) $(git rev-parse --short HEAD)"
  else git describe --tags --exact-match 2>/dev/null || git rev-parse --short HEAD; fi
}
port() { grep -E '^COLTEX_PORT=' .env 2>/dev/null | cut -d= -f2 || true; }
# `docker compose exec` with a terminal when there is one (the cloudflare token prompt needs it).
exec_server() {
  if [ -t 0 ] && [ -t 1 ]; then compose exec server node src/cli.ts "$@"; else compose exec -T server node src/cli.ts "$@"; fi
}

case "${1:-help}" in
  start) compose up -d ;;
  stop) compose down ;;
  restart) compose restart server ;;
  status)
    compose ps
    p="$(port)"; p="${p:-3690}"
    if curl -fsS "http://localhost:$p/api/health" >/dev/null 2>&1; then echo "ColTex is up: http://localhost:$p"; else echo "ColTex is not answering on port $p"; fi
    ;;
  logs) compose logs -f --tail 100 "${2:-server}" ;;
  version)
    echo "ColTex $(current)"
    ;;
  update)
    from="$(current)"
    to="${2:-}"
    if [ -z "$to" ]; then
      # On the main branch (installed with --version main) updates follow main; otherwise releases.
      if git symbolic-ref -q HEAD >/dev/null; then to=main; else to="$(git ls-remote --tags --refs origin 'v*' | sed 's|.*refs/tags/||' | sort -V | tail -1)"; fi
    fi
    [ -n "$to" ] || { echo "No release found" >&2; exit 1; }
    if [ "$to" = main ]; then
      git fetch --depth 1 origin main && git checkout -q -B main FETCH_HEAD
    else
      if [ "$to" = "$from" ]; then echo "ColTex $from is the latest release"; exit 0; fi
      git fetch --depth 1 --force origin tag "$to" && git -c advice.detachedHead=false checkout -q "$to"
    fi
    echo "Updating ColTex $from → $(current); see the release notes: https://github.com/Lewen-Cai/coltex/releases"
    compose up -d --build
    ;;
  edition)
    current="$(grep -E '^COLTEX_EDITION=' .env 2>/dev/null | cut -d= -f2 || true)"
    current="${current:-standard}"
    case "${2:-}" in
      "") echo "TeX Live edition: $current (standard: without package manuals, about 9 GB; full: with them, about 20 GB)" ;;
      standard | full)
        if [ "$2" = "$current" ]; then echo "Already the $2 edition"; exit 0; fi
        if grep -q '^COLTEX_EDITION=' .env; then sed -i.bak "s/^COLTEX_EDITION=.*/COLTEX_EDITION=$2/" .env && rm -f .env.bak
        else echo "COLTEX_EDITION=$2" >>.env; fi
        echo "Switching to the $2 edition: rebuilding the compiler (downloads TeX Live)…"
        compose up -d --build compiler
        echo "Done. The previous TeX Live image can be removed with: docker image prune"
        ;;
      *) echo "Usage: coltex edition [standard | full]" >&2; exit 2 ;;
    esac
    ;;
  tailscale | cloudflare)
    cmd="$1"
    shift
    exec_server "$cmd" "$@"
    ;;
  cli)
    shift
    exec_server "$@"
    ;;
  *)
    sed -n '2,10p' "$self" | sed 's/^# \{0,1\}//'
    ;;
esac
