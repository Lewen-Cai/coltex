# <<< messages
# The images ColTex's own containers run now.
running_images() {
  local id
  for id in $(compose ps -q server compiler 2>/dev/null); do docker inspect -f '{{.Image}}' "$id" 2>/dev/null || true; done
}
# Start the given services (default: all) on this version's images: pulled from ghcr.io, or
# built here with COLTEX_BUILD=1 or when there are none for this version. Afterwards the
# images the containers ran before are removed (TeX Live is several GB per version).
deploy() {
  local before after old
  before="$(running_images)"
  if [ "$(get COLTEX_BUILD)" = 1 ]; then
    compose up -d --build "$@"
  elif pull "$@"; then
    compose up -d "$@"
  elif grep -qiE 'manifest unknown|no matching manifest|manifest for .* not found|failed to resolve reference.*not found' "$PULLED"; then
    # Only when there are none for this version; a network or registry error is not a reason
    # to build TeX Live here.
    T no_prebuilt version="$(get COLTEX_IMAGE_TAG)"
    compose up -d --build "$@"
  else
    T pull_failed >&2
    exit 1
  fi
  after=" $(running_images | tr '\n' ' ') "
  for old in $before; do
    case "$after" in *" $old "*) ;; *) docker image rm "$old" >/dev/null 2>&1 || true ;; esac
  done
}
# `docker compose pull`, shown as it goes and kept in $PULLED, so a failure can say why.
PULLED="$(mktemp "${TMPDIR:-/tmp}/coltex-pull.XXXXXX")"
trap 'rm -f "$PULLED"' EXIT
pull() {
  local rc
  set +e
  compose pull "$@" 2>&1 | tee "$PULLED"
  rc=${PIPESTATUS[0]}
  set -e
  return "$rc"
}
# `docker compose exec` with a terminal when there is one (the cloudflare token prompt needs it).
exec_server() {
  if [ -t 0 ] && [ -t 1 ]; then compose exec server node src/cli.ts "$@"; else compose exec -T server node src/cli.ts "$@"; fi
}

case "${1:-help}" in
  start) compose up -d ;;
  stop) compose down ;;
  restart) compose restart server ;;
  status)
    compose ps
    p="$(port)"; p="${p:-3690}"
    if curl -fsS "http://localhost:$p/api/health" >/dev/null 2>&1; then T up url="http://localhost:$p"
    else T not_answering port="$p"; fi
    ;;
  logs) compose logs -f --tail 100 "${2:-server}" ;;
  version)
    echo "ColTex $(current)"
    ;;
  update)
    from="$(current)"
    to="${2:-}"
    if [ -z "$to" ]; then
      # On the main branch (installed with --version main) updates follow main; otherwise releases.
      if git symbolic-ref -q HEAD >/dev/null; then to=main; else to="$(git ls-remote --tags --refs origin 'v*' | sed 's|.*refs/tags/||' | sort -V | tail -1)"; fi
    fi
    [ -n "$to" ] || { T no_release >&2; exit 1; }
    if [ "$to" = main ]; then
      git fetch --depth 1 origin main && git checkout -q -B main FETCH_HEAD
    else
      if [ "$to" = "$from" ]; then T latest version="$from"; exit 0; fi
      git fetch --depth 1 --force origin tag "$to" && git -c advice.detachedHead=false checkout -q "$to"
    fi
    T updating from="$from" to="$(current)"
    setting COLTEX_IMAGE_TAG "$to"
    deploy
    ;;
  deploy)
    # Used by install.sh.
    shift
    deploy "$@"
    ;;
  edition)
    current="$(get COLTEX_EDITION)"
    current="${current:-standard}"
    case "${2:-}" in
      "") T edition_show edition="$current" ;;
      standard | full)
        if [ "$2" = "$current" ]; then T edition_already edition="$2"; exit 0; fi
        setting COLTEX_EDITION "$2"
        T edition_switching edition="$2"
        deploy compiler
        T done
        ;;
      *) T edition_usage >&2; exit 2 ;;
    esac
    ;;
  tailscale | cloudflare)
    cmd="$1"
    shift
    exec_server "$cmd" "$@"
    ;;
  cli)
    shift
    exec_server "$@"
    ;;
  *) T help ;;
esac
