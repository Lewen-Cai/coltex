#!/usr/bin/env bash
# ColTex on this machine. Run from anywhere (install.sh links it into ~/.local/bin):
#
#   coltex start | stop | restart | status | logs [service] | version
#   coltex update [VERSION]           to the latest release (or VERSION, e.g. v0.0.2, or main)
#   coltex edition [standard | full]  show or switch the TeX Live edition
#   coltex tailscale [status | up | down | off]
#   coltex cloudflare [status | quick | token [TOKEN] | off]
#   coltex cli <command…>             any `node src/cli.ts` command, e.g. `coltex cli system-admin <email>`
#   coltex reset                      delete all data and start again from the setup page
#   coltex uninstall                  remove ColTex from this machine (containers, data, images,
#                                     this folder); Docker stays
#
# The images come prebuilt from ghcr.io for the installed version (COLTEX_IMAGE_TAG in .env);
# COLTEX_BUILD=1 in .env (install.sh --build) builds them from the sources here instead.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
DIR="$(cd "$(dirname "$self")" && pwd)"
cd "$DIR"

compose() { docker compose "$@"; }
# The installed release (its tag), or main and the commit.
current() {
  if git symbolic-ref -q HEAD >/dev/null; then echo "$(git rev-parse --abbrev-ref HEAD) $(git rev-parse --short HEAD)"
  else git describe --tags --exact-match 2>/dev/null || git rev-parse --short HEAD; fi
}
# A setting in .env, or nothing when it isn't there.
get() { grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true; }
# A setting in .env: replaced when there, added when not.
setting() {
  if grep -q "^$1=" .env 2>/dev/null; then sed -i.bak "s|^$1=.*|$1=$2|" .env && rm -f .env.bak; else echo "$1=$2" >>.env; fi
}
port() { get COLTEX_PORT; }
# The language chosen at install (COLTEX_LANG; zh from before there were more is zh-CN).
LANGUAGE="$(get COLTEX_LANG)"
case "$LANGUAGE" in zh) LANGUAGE=zh-CN ;; en | zh-CN | zh-TW | ja | ko | es | fr | de | pt-BR | it | ru | tr | vi | id) ;; *) LANGUAGE=en ;; esac
# A message in that language, with a newline: T key [name=value…], each {name} in it replaced
# by the value. Each language is a function below (msg_en, msg_zh_CN, …) setting M; a missing
# one falls back to English.
T() {
  local key="$1" kv
  shift
  M=""
  if declare -F "msg_${LANGUAGE//-/_}" >/dev/null; then "msg_${LANGUAGE//-/_}" "$key"; fi
  [ -n "$M" ] || msg_en "$key"
  for kv in "$@"; do M="${M//\{${kv%%=*}\}/${kv#*=}}"; done
  printf '%s\n' "$M"
}
# >>> messages (one function per language; keep the keys the same in all of them)
msg_en() {
  case "$1" in
    no_prebuilt) M='No prebuilt images for ColTex {version}; building them from the sources (this takes a while)…' ;;
    pull_failed) M='Downloading the images failed. Check the network connection and try again.' ;;
    up) M='ColTex is up: {url}' ;;
    not_answering) M='ColTex is not answering on port {port}' ;;
    no_release) M='No release found' ;;
    latest) M='ColTex {version} is the latest release' ;;
    updating) M='Updating ColTex {from} → {to}; see the release notes: https://github.com/Lewen-Cai/coltex/releases' ;;
    edition_show) M='TeX Live edition: {edition} (standard: without package manuals, about 9 GB; full: with them, about 20 GB)' ;;
    edition_already) M='Already the {edition} edition' ;;
    edition_switching) M='Switching to the {edition} edition (downloads TeX Live)…' ;;
    done) M='Done.' ;;
    edition_usage) M='Usage: coltex edition [standard | full]' ;;
    help) M='ColTex on this machine. Run from anywhere (install.sh links it into ~/.local/bin):

  coltex start | stop | restart | status | logs [service] | version
  coltex update [VERSION]           to the latest release (or VERSION, e.g. v0.0.2, or main)
  coltex edition [standard | full]  show or switch the TeX Live edition
  coltex tailscale [status | up | down | off]
  coltex cloudflare [status | quick | token [TOKEN] | off]
  coltex cli <command…>             any `node src/cli.ts` command, e.g. `coltex cli system-admin <email>`
  coltex reset                      delete all data and start again from the setup page
  coltex uninstall                  remove ColTex from this machine (containers, data, images, this folder)' ;;
    pull_retry) M='The download was cut off; trying again ({n}/{max})…' ;;
    pull_hint) M='If ghcr.io is slow from here: set COLTEX_IMAGES in .env to a mirror of ghcr.io (registry-mirrors in Docker’s daemon.json only applies to Docker Hub). If the connection keeps breaking: set "max-concurrent-downloads": 1 and "max-download-attempts": 10 in /etc/docker/daemon.json and restart Docker.' ;;
    fixing_data) M='Giving the data folder to the user the containers run as ({owner})…' ;;
    reset_warning) M='This deletes everything in this ColTex: accounts, projects and their history, the database, and the data folder (Tailscale’s device keys too). The settings in .env stay. It can’t be undone.' ;;
    reset_confirm) M='Type reset to go ahead:' ;;
    reset_cancelled) M='Cancelled; nothing was deleted.' ;;
    reset_done) M='Reset. ColTex is starting; open it to create the administrator account.' ;;
    uninstall_warning) M='This removes ColTex from this machine: its containers, the database, the data folder (every project and its history), its images, the coltex command and the ColTex folder. Docker stays. It can’t be undone; make a backup first if you want to keep anything.' ;;
    uninstall_confirm) M='Type uninstall to go ahead:' ;;
    uninstall_done) M='ColTex has been removed, {dir} too. Docker itself stays installed.' ;;
  esac
}
