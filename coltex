# >>> shared (the same in install.sh and coltex, checked by apps/server/test/shell-scripts.test.ts;
# they need TTY, ESC, the colours, cursor_hide/cursor_show, LOG, T, get, GHCR_IMAGES and ALIYUN_IMAGES)
SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
# Columns a string takes: one per character (UTF-8 continuation bytes don't count), two for
# CJK and Hangul (lead bytes E3-ED) and full-width forms (EF BC/BD).
width() {
  local s="$1" bytes cont wide full
  bytes=$(printf '%s' "$s" | LC_ALL=C wc -c | tr -d ' ')
  cont=$(printf '%s' "$s" | LC_ALL=C tr -cd '\200-\277' | LC_ALL=C wc -c | tr -d ' ')
  wide=$(printf '%s' "$s" | LC_ALL=C tr -cd '\343-\355' | LC_ALL=C wc -c | tr -d ' ')
  full=$( (printf '%s' "$s" | LC_ALL=C grep -o $'\357[\274\275]' || true) | wc -l | tr -d ' ')
  echo $((bytes - cont + wide + full))
}
# The string padded with spaces to $2 columns.
pad() {
  local w
  w=$(width "$1")
  printf '%s%*s' "$1" $(($2 > w ? $2 - w : 0)) ''
}

done_line() { printf '\r%s  %s %s\n' "${ESC}[2K" "${GREEN}✓${RESET}" "$1"; }
note() { printf '  %s\n' "${DIM}$*${RESET}"; }

# Run a command with a spinner (output to the log); ✓ when it worked, else its exit code
# with the line cleared.
spin() {
  local label="$1" pid rc=0 i=0
  shift
  printf '\n==> %s\n' "$label" >>"$LOG"
  if [ "$TTY" != 1 ]; then
    printf '==> %s\n' "$label"
    "$@" >>"$LOG" 2>&1 || return $?
    return 0
  fi
  cursor_hide
  "$@" >>"$LOG" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r  %s %s' "${BLUE}${SPIN[i % 10]}${RESET}" "$label"
    i=$((i + 1))
    sleep 0.08
  done
  wait "$pid" || rc=$?
  cursor_show
  if [ "$rc" = 0 ]; then done_line "$label"; else printf '\r%s' "${ESC}[2K"; fi
  return "$rc"
}

# Bytes as "1.2 GB" or "340 MB".
size() { awk -v b="$1" 'BEGIN { if (b >= 1e9) printf "%.1f GB", b / 1e9; else printf "%.0f MB", b / 1e6 }'; }
# The bytes between two counts over some seconds, as "12.3 MB/s" or "640 KB/s".
speed() { awk -v a="$1" -v b="$2" -v t="$3" 'BEGIN { r = (b - a) / t; if (r < 0) r = 0; if (r >= 1e6) printf "%.1f MB/s", r / 1e6; else printf "%.0f KB/s", r / 1e3 }'; }

# The compressed size of every layer the pull will download, as "<short id> <bytes>" lines (shared
# layers once), asked of the registries before it starts (`docker manifest inspect`: each image's
# layers for this machine's platform), so the bar's total is right from the start. Images already
# here are left out; nothing when the registries can't be asked (offline, an older Docker).
layer_sizes() {
  local arch img
  arch="$(docker version -f '{{.Server.Arch}}' 2>/dev/null || true)"
  for img in $(docker compose config --images "$@" 2>/dev/null); do
    docker image inspect "$img" >/dev/null 2>&1 && continue
    docker manifest inspect -v "$img" 2>/dev/null | awk -v arch="$arch" '
      /"Ref":/ { platform = "" }
      /"architecture":/ { v = $0; gsub(/.*: *"|".*/, "", v); platform = v }
      /"layers": *\[/ { layers = 1; next }
      layers && /^[ \t]*\]/ { layers = 0 }
      layers && /"digest":/ { d = $0; sub(/.*sha256:/, "", d); sub(/".*/, "", d) }
      layers && /"size":/ { n = $0; gsub(/[^0-9]/, "", n); if (platform == "" || arch == "" || platform == arch) print substr(d, 1, 12), n }
    ' || true
  done | sort -u
}

# `docker compose pull` with a download bar from compose's JSON progress. The total comes from
# layer_sizes (less the layers compose finds already here); without it, from the layers' sizes
# as each starts, and the percentage never goes back. Every byte count stays in awk (printed
# with %.0f: some awks print large numbers as 7.23839e+09, which bash can't count with), and
# drawing runs apart from the pull, so nothing that goes wrong on screen interrupts the download.
# No spinner: the line changes only when compose reports progress. The speed is over the last
# few seconds (bash 3.2 has whole seconds only).
pull_with_bar() {
  local label="$1" sizes rc
  shift
  printf '\n==> %s\n' "$label" >>"$LOG"
  if [ "$TTY" != 1 ]; then
    printf '==> %s\n' "$label"
    docker compose pull "$@" >>"$LOG" 2>&1
    return
  fi
  # Where from, once (not again on each retry; again after a switch to GitHub).
  if [ -z "${NOTED:-}" ]; then
    local from
    from="$(get COLTEX_IMAGES)"
    case "${from:-$GHCR_IMAGES}" in
      "$ALIYUN_IMAGES") note "$(T download_aliyun)" ;;
      "$GHCR_IMAGES") note "$(T download_github)" ;;
      *) note "$(T download_other registry="${from%%/*}")" ;;
    esac
  fi
  NOTED=1
  cursor_hide
  printf '\r    %s' "$label"
  # Asking the registries takes a few seconds; the line above is already there meanwhile.
  sizes="$(mktemp "${TMPDIR:-/tmp}/coltex-layers.XXXXXX")"
  layer_sizes "$@" >"$sizes" 2>/dev/null || true
  set +e
  docker compose --progress json pull "$@" 2>&1 | tee -a "$LOG" | awk -v sizes="$sizes" '
    BEGIN { while ((getline line < sizes) > 0) { split(line, f, " "); want[f[1]] = f[2] + 0; known += f[2] + 0 } last = -1 }
    !/"parent_id"/ { next }
    {
      id = ""; if (match($0, /"id":"[^"]*"/)) id = substr($0, RSTART + 6, RLENGTH - 7)
      if ($0 ~ /"text":"Already exists"/) { if ((id in want) && !(id in here)) { here[id] = 1; known -= want[id] } next }
      if (!(id in want) && match($0, /"total":[0-9]+/)) extra[id] = substr($0, RSTART + 8, RLENGTH - 8) + 0
      if ($0 ~ /"text":"Downloading"/ && match($0, /"current":[0-9]+/)) got[id] = substr($0, RSTART + 10, RLENGTH - 10) + 0
      if ($0 ~ /"text":"(Download complete|Pull complete)"/) { if (id in want) got[id] = want[id]; else if (id in extra) got[id] = extra[id] }
      s = 0; t = known
      for (k in got) s += got[k]
      for (k in extra) t += extra[k]
      if (t <= 0) next
      if (s > t) s = t
      p = int(s * 100 / t); if (p < last) p = last
      # Also every megabyte, for the speed.
      if (p != last || t != lastt || s - lasts >= 1e6) { printf "%d %d %.0f %.0f\n", p, int(p * 20 / 100), s, t; fflush(); last = p; lastt = t; lasts = s }
    }' | {
    ( t0=$SECONDS c0=0 t1=$SECONDS c1=0 drawn=-1 shown=-1 rate=""
      while read -r pct filled cur tot; do
        # At most once a second, unless the percentage moved.
        [ "$pct" != "$shown" ] || [ "$SECONDS" != "$drawn" ] || continue
        if [ $((SECONDS - t1)) -ge 3 ]; then t0=$t1 c0=$c1 t1=$SECONDS c1=$cur; fi
        [ $((SECONDS - t0)) -lt 1 ] || rate=" · $(speed "$c0" "$cur" $((SECONDS - t0)))"
        # The track in its own grey, not dimmed blue: some terminals (PuTTY, xterm.js) draw
        # dim text at full strength, and the bar looked full from the start.
        bar="$BLUE"
        for ((k = 0; k < 20; k++)); do [ "$k" = "$filled" ] && bar+="$GRAY"; bar+="━"; done
        printf '\r%s    %s %s%s %3d%%  %s' "${ESC}[2K" "$(pad "$label" 16)" "$bar" "$RESET" "$pct" \
          "${DIM}$(size "$cur") / $(size "$tot")$rate${RESET}"
        drawn=$SECONDS shown=$pct
      done ) 2>/dev/null
    cat >/dev/null
  }
  rc=${PIPESTATUS[0]}
  set -e
  rm -f "$sizes"
  cursor_show
  if [ "$rc" = 0 ]; then done_line "$label"; else printf '\r%s' "${ESC}[2K"; fi
  return "$rc"
}

# Whether the pull failed because there are no prebuilt images for this version (then they are
# built here), rather than for the network or the registry (then that is the error).
images_missing() { tail -n 40 "$LOG" | grep -qiE 'manifest unknown|no matching manifest|manifest for .* not found|failed to resolve reference.*not found'; }

# The images (all, or the services given): pulled with a bar, or plainly when this Compose has no JSON progress. A pull cut
# off by the network is tried again (Docker keeps the layers it finished, so each try only
# fetches the rest), up to PULL_TRIES times in all.
PULL_TRIES=3
pull_once() {
  local label
  label="$(T downloading)"
  pull_with_bar "$label" "$@" && return 0
  # A Compose without JSON progress said so instead of pulling.
  if tail -n 3 "$LOG" | grep -qi 'progress'; then spin "$label" docker compose pull "$@" && return 0; fi
  return 1
}
pull_images() {
  local try=1
  until pull_once "$@"; do
    images_missing && return 1
    [ "$try" -lt "$PULL_TRIES" ] || return 1
    try=$((try + 1))
    note "$(T pull_retry n="$try" max="$PULL_TRIES")"
    sleep 3
  done
}
# <<< shared

# The images ColTex's own containers run now.
running_images() {
  local id
  for id in $(compose ps -q server compiler 2>/dev/null); do docker inspect -f '{{.Image}}' "$id" 2>/dev/null || true; done
}
# `docker compose up -d` as one line that turns into ✓; on failure, the end of its output.
up() {
  spin "$(T starting)" docker compose up -d "$@" && return 0
  printf '\n%s\n\n' "${DIM}$(tail -n 15 "$LOG" | sed 's/^/    /')${RESET}" >&2
  exit 1
}
# Start the given services (default: all) on this version's images: pulled from ghcr.io, or
# built here with COLTEX_BUILD=1 or when there are none for this version. Afterwards the
# images the containers ran before are removed (TeX Live is several GB per version).
deploy() {
  local before after old
  before="$(running_images)"
  quiet_bind
  if [ "$(get COLTEX_BUILD)" = 1 ]; then
    ensure_data
    up --build "$@"
  elif pull_images "$@"; then
    ensure_data
    up "$@"
  elif images_missing; then
    # Only when there are none for this version; a network or registry error is not a reason
    # to build TeX Live here.
    T no_prebuilt version="$(get COLTEX_IMAGE_TAG)"
    ensure_data
    up --build "$@"
  else
    printf '\n%s\n\n' "${DIM}$(tail -n 15 "$LOG" | sed 's/^/    /')${RESET}" >&2
    T pull_failed >&2
    T pull_hint >&2
    exit 1
  fi
  after=" $(running_images | tr '\n' ' ') "
  for old in $before; do
    case "$after" in *" $old "*) ;; *) docker image rm "$old" >/dev/null 2>&1 || true ;; esac
  done
}
# The user id owning a file (GNU and busybox stat, then BSD's).
owner() { stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null || true; }
# ./data and the two folders the compiler mounts, made and owned by the user the containers run
# as (COLTEX_UID). Docker makes a missing mount point owned by root, and the server then can't
# write in it (EACCES on /data/.secret, restarting over and over). Fixed as root, or else by a
# throwaway container of the server's image (anyone who may use Docker may do this anyway).
ensure_data() {
  local uid gid d wrong=""
  uid="$(get COLTEX_UID)"; uid="${uid:-1000}"
  gid="$(get COLTEX_GID)"; gid="${gid:-1000}"
  for d in data data/projects data/outputs; do
    [ -d "$d" ] || mkdir -p "$d" 2>/dev/null || wrong=1
    [ "$(owner "$d")" = "$uid" ] || wrong=1
  done
  [ -n "$wrong" ] || return 0
  T fixing_data owner="$uid:$gid"
  if [ "$(id -u)" = 0 ]; then
    mkdir -p data/projects data/outputs && chown -R "$uid:$gid" data
  else
    compose run --rm --no-deps -T --user 0:0 --entrypoint sh server -c "mkdir -p /data/projects /data/outputs && chown -R $uid:$gid /data"
  fi
}
# Present though empty, so a Compose that reads the port's ${COLTEX_BIND:+…} doesn't warn.
quiet_bind() { [ ! -f .env ] || grep -q '^COLTEX_BIND=' .env || echo 'COLTEX_BIND=' >>.env; }
# `docker compose exec` with a terminal when there is one (the cloudflare token prompt needs it).
exec_server() {
  if [ -t 0 ] && [ -t 1 ]; then compose exec server node src/cli.ts "$@"; else compose exec -T server node src/cli.ts "$@"; fi
}

# Connections to GitHub are sometimes reset on the way ("Recv failure: Connection reset by
# peer"), so a git command that goes over the network is tried up to four times.
net() {
  local try
  for try in 1 2 3; do
    "$@" && return 0
    sleep "$try"
  done
  "$@"
}

# After the update's checkout: the new image tag, then the images and the containers.
finish_update() {
  T updating from="$1" to="$(current)"
  setting COLTEX_IMAGE_TAG "$2"
  deploy
}

case "${1:-help}" in
  start) quiet_bind; ensure_data; compose up -d ;;
  stop) compose down ;;
  restart) ensure_data; compose restart server ;;
  status)
    compose ps
    p="$(port)"; p="${p:-3690}"
    if curl -fsS "http://localhost:$p/api/health" >/dev/null 2>&1; then T up url="http://localhost:$p"
    else T not_answering port="$p"; fi
    ;;
  logs) compose logs -f --tail 100 "${2:-server}" ;;
  version)
    echo "ColTex $(current)"
    ;;
  update)
    from="$(current)"
    to="${2:-}"
    if [ -z "$to" ]; then
      # On the main branch (installed with --version main) updates follow main; otherwise releases
      # (never a pre-release unless it is named).
      if git symbolic-ref -q HEAD >/dev/null; then to=main; else to="$(net git ls-remote --tags --refs origin 'v*' | sed 's|.*refs/tags/||' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)"; fi
    fi
    [ -n "$to" ] || { T no_release >&2; exit 1; }
    if [ "$to" = main ]; then
      net git fetch -q --depth 1 origin main && git checkout -q -B main FETCH_HEAD
    else
      if [ "$to" = "$from" ]; then T latest version="$from"; exit 0; fi
      net git fetch -q --depth 1 --force origin tag "$to" && git -c advice.detachedHead=false checkout -q "$to"
    fi
    # The rest is done by the version just checked out, so whatever it needs on the way (a
    # setting to add, an image address that moved) is done by its own code. One that can't (an
    # older coltex, or one that doesn't parse) leaves it to this one.
    if bash -n "$DIR/coltex" 2>/dev/null && grep -q '^  finish-update)' "$DIR/coltex"; then
      rm -f "$LOG"
      exec bash "$DIR/coltex" finish-update "$from" "$to"
    fi
    finish_update "$from" "$to"
    ;;
  finish-update)
    # The second half of `coltex update`, run by the coltex of the version it updated to.
    finish_update "$2" "$3"
    ;;
  deploy)
    # Used by install.sh.
    shift
    deploy "$@"
    ;;
  edition)
    current="$(get COLTEX_EDITION)"
    current="${current:-standard}"
    case "${2:-}" in
      "") T edition_show edition="$current" ;;
      standard | full)
        if [ "$2" = "$current" ]; then T edition_already edition="$2"; exit 0; fi
        setting COLTEX_EDITION "$2"
        T edition_switching edition="$2"
        deploy compiler
        T done
        ;;
      *) T edition_usage >&2; exit 2 ;;
    esac
    ;;
  tailscale | cloudflare)
    cmd="$1"
    shift
    exec_server "$cmd" "$@"
    ;;
  reset-password | system-admin)
    exec_server "$@"
    ;;
  cli)
    shift
    # Without a command, the list of commands (the server's own is one line in English).
    if [ $# = 0 ]; then T help; exit 0; fi
    exec_server "$@"
    ;;
  reset)
    # Everything back to a fresh install: the containers and their volumes (database, Valkey,
    # build cache) and data/; .env stays. Asks first, with a word to type, not a y.
    T reset_warning
    printf '%s ' "$(T reset_confirm)"
    answer=""
    IFS= read -r answer || true
    [ "$answer" = reset ] || { T reset_cancelled; exit 1; }
    compose down -v --remove-orphans
    if [ "$(id -u)" = 0 ] || [ "$(owner data)" = "$(id -u)" ]; then
      rm -rf data 2>/dev/null || true
    fi
    # What this user can't remove (made by a container as root): removed by one as root.
    if [ -d data ] && [ -n "$(ls -A data 2>/dev/null)" ]; then
      compose run --rm --no-deps -T --user 0:0 --entrypoint sh server -c 'find /data -mindepth 1 -delete'
    fi
    ensure_data
    compose up -d
    T reset_done
    ;;
  uninstall)
    # ColTex gone from this machine: its containers, volumes, data, images, the coltex links and
    # this folder. Docker stays. Asks first, with a word to type, not a y.
    T uninstall_warning
    printf '%s ' "$(T uninstall_confirm)"
    answer=""
    IFS= read -r answer || true
    [ "$answer" = uninstall ] || { T reset_cancelled; exit 1; }
    # Only ever this checkout's folder.
    [ -f "$DIR/docker-compose.yml" ] && [ -f "$DIR/coltex" ] && [ "$DIR" != / ] && [ "$DIR" != "$HOME" ] || exit 1
    # Leave the tailnet first, so the built-in Tailscale's device doesn't stay behind in it.
    compose exec -T server node src/cli.ts tailscale down >/dev/null 2>&1 || true
    compose down -v --remove-orphans
    if [ "$(id -u)" = 0 ] || [ "$(owner data)" = "$(id -u)" ]; then
      rm -rf data 2>/dev/null || true
    fi
    # What this user can't remove (made by a container as root): removed by one as root, while the
    # server image is still here.
    if [ -d data ] && [ -n "$(ls -A data 2>/dev/null)" ]; then
      compose run --rm --no-deps -T --user 0:0 --entrypoint sh server -c 'find /data -mindepth 1 -delete' || true
    fi
    compose down --rmi all --remove-orphans >/dev/null 2>&1 || true
    for link in "$HOME/.local/bin/coltex" /usr/local/bin/coltex; do
      if [ -L "$link" ] && [ "$(readlink "$link")" = "$DIR/coltex" ]; then rm -f "$link" 2>/dev/null || true; fi
    done
    T uninstall_done dir="$DIR"
    cd /
    exec rm -rf "$DIR"
    ;;
  *) T help ;;
esac
