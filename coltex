    pull_retry) M='Quá trình tải bị ngắt; đang thử lại ({n}/{max})…' ;;
    pull_hint) M='Nếu ghcr.io chậm từ đây: đặt COLTEX_IMAGES trong .env thành một bản sao (mirror) của ghcr.io (registry-mirrors trong daemon.json của Docker chỉ áp dụng cho Docker Hub). Nếu kết nối cứ bị ngắt: đặt "max-concurrent-downloads": 1 và "max-download-attempts": 10 trong /etc/docker/daemon.json rồi khởi động lại Docker.' ;;
