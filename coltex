ESC=$'\033'
RESET="" BOLD="" DIM="" BLUE="" GRAY="" GREEN="" RED=""
if [ "$TTY" = 1 ] && [ -z "${NO_COLOR:-}" ]; then
  RESET="${ESC}[0m" BOLD="${ESC}[1m" DIM="${ESC}[2m"
  case "${COLORTERM:-}" in
    truecolor | 24bit)
      BLUE="${ESC}[38;2;37;99;235m" GRAY="${ESC}[38;2;128;128;128m" GREEN="${ESC}[38;2;22;163;74m" RED="${ESC}[38;2;220;38;38m" ;;
    *)
      BLUE="${ESC}[38;5;27m" GRAY="${ESC}[38;5;244m" GREEN="${ESC}[38;5;34m" RED="${ESC}[38;5;160m" ;;
  esac
fi
cursor_hide() { [ "$TTY" = 1 ] && printf '%s' "${ESC}[?25l" || true; }
cursor_show() { [ "$TTY" = 1 ] && printf '%s' "${ESC}[?25h" || true; }
