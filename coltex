#!/usr/bin/env bash
# ColTex on this machine. Run from anywhere (install.sh links it into ~/.local/bin):
#
#   coltex start | stop | restart | status | logs [service] | version
#   coltex update [VERSION]          to the latest release (or VERSION, e.g. v0.0.2, or main)
#   coltex edition [standard | full]  show or switch the TeX Live edition
#   coltex tailscale [status | up | down | off]
#   coltex cloudflare [status | quick | token [TOKEN] | off]
#   coltex cli <command…>          any `node src/cli.ts` command, e.g. `coltex cli system-admin <email>`
#
# The images come prebuilt from ghcr.io for the installed version (COLTEX_IMAGE_TAG in .env);
# COLTEX_BUILD=1 in .env (install.sh --build) builds them from the sources here instead.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
DIR="$(cd "$(dirname "$self")" && pwd)"
cd "$DIR"

compose() { docker compose "$@"; }
# The installed release (its tag), or main and the commit.
current() {
  if git symbolic-ref -q HEAD >/dev/null; then echo "$(git rev-parse --abbrev-ref HEAD) $(git rev-parse --short HEAD)"
  else git describe --tags --exact-match 2>/dev/null || git rev-parse --short HEAD; fi
}
# A setting in .env, or nothing when it isn't there.
get() { grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true; }
# A setting in .env: replaced when there, added when not.
setting() {
  if grep -q "^$1=" .env 2>/dev/null; then sed -i.bak "s|^$1=.*|$1=$2|" .env && rm -f .env.bak; else echo "$1=$2" >>.env; fi
}
port() { get COLTEX_PORT; }
# The images ColTex's own containers run now.
running_images() {
  local id
  for id in $(compose ps -q server compiler 2>/dev/null); do docker inspect -f '{{.Image}}' "$id" 2>/dev/null || true; done
}
# Start the given services (default: all) on this version's images: pulled from ghcr.io, or
# built here with COLTEX_BUILD=1 or when there are none for this version. Afterwards the
# images the containers ran before are removed (TeX Live is several GB per version).
deploy() {
  local before after old
  before="$(running_images)"
  if [ "$(get COLTEX_BUILD)" = 1 ]; then
    compose up -d --build "$@"
  elif compose pull "$@"; then
    compose up -d "$@"
  else
    echo "No prebuilt images for ColTex $(get COLTEX_IMAGE_TAG); building them from the sources (this takes a while)…"
    compose up -d --build "$@"
  fi
  after=" $(running_images | tr '\n' ' ') "
  for old in $before; do
    case "$after" in *" $old "*) ;; *) docker image rm "$old" >/dev/null 2>&1 || true ;; esac
  done
}
# `docker compose exec` with a terminal when there is one (the cloudflare token prompt needs it).
exec_server() {
  if [ -t 0 ] && [ -t 1 ]; then compose exec server node src/cli.ts "$@"; else compose exec -T server node src/cli.ts "$@"; fi
}

case "${1:-help}" in
  start) compose up -d ;;
  stop) compose down ;;
  restart) compose restart server ;;
  status)
    compose ps
    p="$(port)"; p="${p:-3690}"
    if curl -fsS "http://localhost:$p/api/health" >/dev/null 2>&1; then echo "ColTex is up: http://localhost:$p"; else echo "ColTex is not answering on port $p"; fi
    ;;
  logs) compose logs -f --tail 100 "${2:-server}" ;;
  version)
    echo "ColTex $(current)"
    ;;
  update)
    from="$(current)"
    to="${2:-}"
    if [ -z "$to" ]; then
      # On the main branch (installed with --version main) updates follow main; otherwise releases.
      if git symbolic-ref -q HEAD >/dev/null; then to=main; else to="$(git ls-remote --tags --refs origin 'v*' | sed 's|.*refs/tags/||' | sort -V | tail -1)"; fi
    fi
    [ -n "$to" ] || { echo "No release found" >&2; exit 1; }
    if [ "$to" = main ]; then
      git fetch --depth 1 origin main && git checkout -q -B main FETCH_HEAD
    else
      if [ "$to" = "$from" ]; then echo "ColTex $from is the latest release"; exit 0; fi
      git fetch --depth 1 --force origin tag "$to" && git -c advice.detachedHead=false checkout -q "$to"
    fi
    echo "Updating ColTex $from → $(current); see the release notes: https://github.com/Lewen-Cai/coltex/releases"
    setting COLTEX_IMAGE_TAG "$to"
    deploy
    ;;
  deploy)
    # Used by install.sh.
    shift
    deploy "$@"
    ;;
  edition)
    current="$(get COLTEX_EDITION)"
    current="${current:-standard}"
    case "${2:-}" in
      "") echo "TeX Live edition: $current (standard: without package manuals, about 9 GB; full: with them, about 20 GB)" ;;
      standard | full)
        if [ "$2" = "$current" ]; then echo "Already the $2 edition"; exit 0; fi
        setting COLTEX_EDITION "$2"
        echo "Switching to the $2 edition (downloads TeX Live)…"
        deploy compiler
        echo "Done."
        ;;
      *) echo "Usage: coltex edition [standard | full]" >&2; exit 2 ;;
    esac
    ;;
  tailscale | cloudflare)
    cmd="$1"
    shift
    exec_server "$cmd" "$@"
    ;;
  cli)
    shift
    exec_server "$@"
    ;;
  *)
    sed -n '2,10p' "$self" | sed 's/^# \{0,1\}//'
    ;;
esac
